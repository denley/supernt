#!/bin/sh
# Manage test cores on the Super Nt SD card (mounted at $SD, default /mnt/sd).
#
#   tools/sdcore setup      copy the stock JB7.2 core and out/*.cor into $SD/TESTCORES (numbered),
#                           and a test .spc (tools/mkspc.py) into $SD/SPC
#   tools/sdcore list       list TESTCORES, marking the one installed as SYSTEM/CORES/spc.cor
#   tools/sdcore use NAME   install a TESTCORES core as spc.cor (NAME: `09`, `q-snes` or `09-q-snes`)
#   tools/sdcore roms       copy the ROMs wrapped for q-snes_load (make load-spcs) into $SD/SPC:
#                           "0 SA1 TEST.spc", "1 Gradius III.spc", "2 Kirby Super Star.spc",
#                           "3 Kirby's Dream Land 3.spc", "4 Super Mario RPG.spc",
#                           "5 SA1 TEST 20S.spc" (20 s song length), "6 Yoshi's Island.spc",
#                           "7 Star Fox.spc" (Super FX, v7; the player's browser sorts
#                           case-sensitively: right below GO BACK), "8 SAVE PROBE.spc" and its
#                           save "SAVES/SNES/8 SAVE PROBE.sav" (notes/snes-load.md, the probe)
#
# The console only loads SYSTEM/CORES/spc.cor, so each test is a swap of that file.
# `use 00` puts the stock JB7.2 core back.
set -e
SD=${SD:-/mnt/sd}
T=$SD/TESTCORES
cd "$(dirname "$0")/.."

# Test order; see notes/hardware-tests.md.
ORDER="spc-colortest spc-invert-ch1 spc-invert-ch2 spc-invert-ch3 vtest q-vtest buslog q-buslog
q-snes plltest blinky q-hwtest q-snes_sdram q-snes_load q-memtest"

[ -d "$SD/SYSTEM/CORES" ] || { echo "no Super Nt card at $SD" >&2; exit 1; }

case $1 in
setup)
	mkdir -p "$T"
	cp firmware/jb7.2/SYSTEM/CORES/spc.cor "$T/00-stock-jb72.cor"
	python3 -I tools/mkspc.py "$SD/SPC/Super Nt test chord.spc"
	n=1
	for c in $ORDER; do
		cp "out/$c.cor" "$T/$(printf %02d $n)-$c.cor"
		n=$((n + 1))
	done
	sync
	"$0" list
	;;
list)
	cur=$(sha1sum < "$SD/SYSTEM/CORES/spc.cor")
	for f in "$T"/*.cor; do
		[ "$(sha1sum < "$f")" = "$cur" ] && m='*' || m=' '
		echo "$m $(basename "$f" .cor)"
	done
	;;
use)
	f=$(ls "$T/$2"-*.cor "$T/$2.cor" "$T"/*-"$2".cor 2>/dev/null | head -n 1)
	[ -n "$f" ] || { echo "no core matching $2 in $T" >&2; exit 1; }
	cp "$f" "$SD/SYSTEM/CORES/spc.cor"
	sync
	echo "installed $(basename "$f" .cor) as SYSTEM/CORES/spc.cor"
	;;
roms)
	for p in "sa1test:0 SA1 TEST" "gradius3:1 Gradius III" "kirbyss:2 Kirby Super Star" \
	    "kdl3:3 Kirby's Dream Land 3" "smrpg:4 Super Mario RPG" "sa1test20:5 SA1 TEST 20S" \
	    "yoshi:6 Yoshi's Island" "starfox:7 Star Fox" "saveprobe:8 SAVE PROBE"; do
		f=build/snes_load/${p%%:*}.spc
		if [ -f "$f" ]; then cp "$f" "$SD/SPC/${p#*:}.spc"; echo "SPC/${p#*:}.spc"; fi
	done
	if [ -f build/snes_load/saveprobe.sav ]; then
		mkdir -p "$SD/SAVES/SNES"
		cp build/snes_load/saveprobe.sav "$SD/SAVES/SNES/8 SAVE PROBE.sav"
		echo "SAVES/SNES/8 SAVE PROBE.sav"
	fi
	sync
	;;
*)
	sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
	exit 1
	;;
esac
